{
  "manifest_version": 3,
  "name": "WikiMasters Pack Hunter",
  "version": "4.0.0",
  "description": "WikiMasters Pack Hunter v3.4 — V3 stable + transfert privé/public, acceptation automatique des demandes d’ami et récupération adaptative des erreurs API.",
  "permissions": [
    "storage",
    "windows"
  ],
  "host_permissions": [
    "https://www.wiki-masters.com/*",
    "https://wiki-masters.com/*",
    "https://10minutemail.com/*"
  ],
  "action": {
    "default_title": "WikiMasters Pack Hunter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "js": [
        "market-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "js": [
        "trade.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "js": [
        "market.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://10minutemail.com/*"
      ],
      "js": [
        "email.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "spanning"
}
